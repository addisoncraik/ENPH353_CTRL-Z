<launch>
   <!-- My Package launch file -->
   <node pkg="time_trials"
         type="move.py"
         name="BALLIN" 
         output="screen">
   </node>
   <!-- Launch The Master -->
	<group ns="Master">
		<param name="tf_prefix" value="Master_tf" />
		<include file="$(find robbie)/launch/robbie.launch">
			<arg name="init_pose" value="-x 5.5 -y 1 -z 1 -R 0.0 -P 0.0 -Y -1.57" />
			<arg name="robot_name"  value="Master" />
            <arg name="camera_orientation" value="0 1.5708 0"/>
			<arg name="lidar_samples" value="50"/>
			<arg name="lidar_angle" value="0.01"/>
		</include>
	</group>

      <!-- Launch The Follower -->
      <group ns="Follower">
		<param name="tf_prefix" value="Follower_tf" />
		<include file="$(find robbie)/launch/robbie.launch">
			<arg name="init_pose" value="-x 4 -y 1 -z 0.5 -R 0.0 -P 0.0 -Y -1.57" />
			<arg name="robot_name"  value="Follower" />
            <arg name="camera_orientation" value="0 0.5 0"/>
			<arg name="lidar_samples" value="100"/>
			<arg name="lidar_angle" value="0.5"/>
		</include>
	</group>

	<!-- <include file="$(find imu_tools)/imu_complementary_filter/launch/complementary_filter.launch"/> -->

</launch>